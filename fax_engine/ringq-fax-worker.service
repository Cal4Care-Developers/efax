[Unit]
Description=RingQ Fax Worker (FreeSWITCH ESL fax engine, multi-tenant)
After=network.target freeswitch.service
Wants=freeswitch.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/fax-engine
EnvironmentFile=/var/www/fax-engine/.env
ExecStart=/var/www/fax-engine/venv/bin/python3 fax_worker.py
Restart=always
RestartSec=3
MemoryMax=512M

[Install]
WantedBy=multi-user.target
